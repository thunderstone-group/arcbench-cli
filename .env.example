# Copy to .env (or ~/.config/arcbench/.env) and fill in. Never commit the result.

# Website session. `arcbench session` fills this in from macOS Chrome.
# On other systems, copy the cookie header from your browser's dev tools:
#   ARC_BENCH_SESSION_COOKIE=arcbench_session=...; arc_api_sticky=...
ARC_BENCH_SESSION_COOKIE=

# Model-gateway key the official runner uses during a submission.
# Leave empty to let the CLI read the account's own key from /api/auth/access-key.
ARC_BENCH_API_KEY=

# Optional platform and model settings.
ARC_BENCH_WEB_BASE_URL=https://arc-bench.com
ARC_BENCH_API_BASE_URL=https://api.arc-bench.com/v1
ARC_BENCH_MODEL=deepseek-v4-flash

# The metering dashboard is a separate service with its own login.
# Only `arcbench balance` and `arcbench whoami --meter` use these.
ARC_BENCH_METER_BASE_URL=https://meter.arc-bench.com
ARC_BENCH_METER_COOKIE=

# Safety controls. The CLI refuses submissions once the record budget is
# exhausted, and enforces a minimum interval between real submissions.
ARC_BENCH_MAX_SUBMISSIONS=4
ARC_BENCH_MIN_INTERVAL_SECONDS=30
ARC_BENCH_HTTP_TIMEOUT_SECONDS=60

# How long `start` may wait for a queue slot before giving up (seconds).
ARC_BENCH_QUEUE_TIMEOUT_SECONDS=3600

# Optional: write submission records somewhere other than ./.arcbench/runs/submissions.
# ARC_BENCH_RECORD_DIR=/absolute/path/to/records
